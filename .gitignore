# ==============================================================================
# DrvLife (LifeRece) — Master .gitignore
# ==============================================================================

# --- Large Archives & Zips (Blocked by GitHub if > 100MB) ---
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# --- Node / Web Dependencies & Output ---
node_modules/
02_WEBSITE/node_modules/
dist/
02_WEBSITE/dist/
02_WEBSITE/deployment/dist/
dist-ssr/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Android / Gradle Build Output & Cache ---
.gradle/
*/.gradle/
*/*/.gradle/
build/
*/build/
*/*/build/
.kotlin/
*/.kotlin/
*/*/.kotlin/
*.hprof
*.dex
local.properties
*/local.properties
*/*/local.properties
.cxx/
*/.cxx/
*/*/.cxx/

# --- Temporary Staging & Debug APKs ---
app-debug.apk
*-debug.apk
01_APP_ANDROID/REVIEW_BEFORE_DELETE/

# --- IDE & Editor Configurations ---
.idea/
*/.idea/
.vscode/*
!.vscode/extensions.json
*.iml
*.ipr
*.iws
*.swp
*~
.DS_Store
Thumbs.db

